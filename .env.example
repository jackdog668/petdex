# Auth.js secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# OAuth providers — create apps and paste their client id/secret.
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string (postgres://...). Used by both the runtime
# (Drizzle ORM) and `bun db:push` / `bun db:generate` (drizzle-kit).
DATABASE_URL=
